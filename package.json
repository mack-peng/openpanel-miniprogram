{
  "name": "openpanel-miniprogram",
  "version": "0.1.0",
  "description": "OpenPanel SDK for WeChat Mini Programs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "openpanel",
    "analytics",
    "miniprogram",
    "wechat",
    "weixin"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openpanel/sdk": "^1.3.1"
  },
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.3.0"
  }
}
